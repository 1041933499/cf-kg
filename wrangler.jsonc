{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kgcheckin",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // 每天北京时间 01:10 = UTC 17:10（前一天）
  "triggers": {
    "crons": ["10 17 * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "KG_KV",
      "id": "7156257152514caeb26b864f8c5b0940"
    }
  ]
}
